# Animarr Configuration

# Port for the Animarr server
PORT=__PORT__

# Optional: Username and Password to protect the Animarr dashboard. 
# If password is empty, no authentication is required.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Prowlarr Configuration
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your_prowlarr_api_key_here

# External API Keys (TMDB, IMDB/OMDB) - Anilist and MAL (Jikan) usually don't require keys for basic search
TMDB_API_KEY=
IMDB_API_KEY=
